{
  "manifest_version": 3,
  "name": "Lincle",
  "version": "3.8.2",
  "description": "Zararlı ve agresif link kısaltıcıları otomatik algılayıp atlayarak doğrudan hedef linke ulaştırır.",
  "permissions": [
    "storage", 
    "contextMenus",
    "clipboardRead",
    "clipboardWrite",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nyxa4807@gmail.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.aternos.org/*",
        "*://*.aternos.me/*",
        "*://*.aternos.host/*",
        "*://*.aternos.com/*",
        "*://*.twitch.tv/*",
        "*://*.spotify.com/*",
        "*://*.discord.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.hulu.com/*",
        "*://*.funimation.com/*",
        "*://*.disneyplus.com/*",
        "*://*.peacocktv.com/*",
        "*://*.dazn.com/*",
        "*://*.mail.google.com/*",
        "*://*.docs.google.com/*",
        "*://*.drive.google.com/*",
        "*://*.outlook.live.com/*",
        "*://*.notion.so/*",
        "*://*.figma.com/*",
        "*://*.canva.com/*"
      ],
      "js": ["popup-shield.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.aternos.org/*",
        "*://*.aternos.me/*",
        "*://*.aternos.host/*",
        "*://*.aternos.com/*",
        "*://*.twitch.tv/*",
        "*://*.spotify.com/*",
        "*://*.discord.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.hulu.com/*",
        "*://*.funimation.com/*",
        "*://*.disneyplus.com/*",
        "*://*.peacocktv.com/*",
        "*://*.dazn.com/*",
        "*://*.mail.google.com/*",
        "*://*.docs.google.com/*",
        "*://*.drive.google.com/*",
        "*://*.outlook.live.com/*",
        "*://*.notion.so/*",
        "*://*.figma.com/*",
        "*://*.canva.com/*"
      ],
      "js": ["resolver.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "trigger-lincle": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Command+Shift+L"
      },
      "description": "Lincle: Mevcut sayfayı zorla temizle"
    }
  }
}